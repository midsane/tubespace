{
    "redirects": [
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "tubespace.vercel.app"
                }
            ],
            "destination": "https://tubespace.studio/$1",
            "permanent": true
        }
    ],
    "routes": [
        {
            "src": "/[^.]+",
            "dest": "/",
            "status": 200
        }
    ]
}