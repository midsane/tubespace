// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

enum Role {
  YOUTUBER
  EDITOR
}

model User {
  id            Int      @id @default(autoincrement())
  name          String?  @unique
  email         String   @unique
  password      String?
  profileImgUrl String?
  salt          String?
  Oauth         Boolean  @default(false)
  role          Role
  createdAt     DateTime @default(now())
  bio           String?
  attachedLinks String?
}

enum Rating_val {
  unrated
  one
  two
  three
  four
  five
}

model Task {
  id          Int        @id @default(autoincrement())
  youtuberId  Int
  editorId    Int
  deadline    DateTime
  title       String
  description String
  attachment  String[]
  isCompleted Boolean    @default(false)
  rating      Rating_val @default(unrated)
  review      String?
}
