// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

enum Role {
  YOUTUBER
  EDITOR
}

model User {
  id            Int      @id @default(autoincrement())
  name          String?  @unique
  email         String   @unique
  password      String?
  profileImgUrl String?
  salt          String?
  Oauth         Boolean  @default(false)
  role          Role
  createdAt     DateTime @default(now())
  bio           String?
  attachedLinks String?
  bannerImgUrl  String?
  editorTasks   Task[]   @relation("EditorTasks", fields: [], references: [])
  youtuberTasks Task[]   @relation("YoutuberTasks", fields: [], references: [])
}

enum Rating_val {
  unrated
  one
  two
  three
  four
  five
}

model Task {
  id              Int      @id @default(autoincrement())
  taskTitle       String
  workDescription String
  deadline        DateTime
  attachments     String[]
  youtuberId      Int
  editorId        Int

  title       String?
  description String?
  tags        String[]
  madeForKids Boolean  @default(false)
  thumbnail   String?

  createdAt   DateTime   @default(now())
  isCompleted Boolean    @default(false)
  rating      Rating_val @default(unrated)
  review      String?
  youtuber    User       @relation("YoutuberTasks", fields: [youtuberId], references: [id])
  editor      User       @relation("EditorTasks", fields: [editorId], references: [id])
}
