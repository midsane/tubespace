// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

enum Role {
  YOUTUBER
  EDITOR
}

model User {
  id               Int       @id @default(autoincrement())
  name             String?   @unique
  email            String    @unique
  password         String?
  profileImgUrl    String?
  salt             String?
  Oauth            Boolean   @default(false)
  role             Role
  createdAt        DateTime  @default(now())
  bio              String?
  attachedLinks    String?
  bannerImgUrl     String?
  editorTasks      Task[]    @relation("EditorTasks", fields: [], references: [])
  youtuberTasks    Task[]    @relation("YoutuberTasks", fields: [], references: [])
  sentMessages     Message[] @relation("SenderMessages")
  receivedMessages Message[] @relation("ReceiverMessages")
}

enum Rating_val {
  unrated
  one
  two
  three
  four
  five
}

model Task {
  id              Int      @id @default(autoincrement())
  taskTitle       String
  workDescription String
  deadline        DateTime
  attachments     String[]
  youtuberId      Int
  editorId        Int

  title       String?
  description String?
  tags        String[]
  madeForKids Boolean  @default(false)
  thumbnail   String?

  createdAt      DateTime   @default(now())
  isCompleted    Boolean    @default(false)
  onServer       Boolean    @default(false)
  editedVideoUrl String?
  rating         Rating_val @default(unrated)
  review         String?
  youtuber       User       @relation("YoutuberTasks", fields: [youtuberId], references: [id])
  editor         User       @relation("EditorTasks", fields: [editorId], references: [id])
}

enum MessageType {
  TEXT
  FILE
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
}

model Message {
  id            Int           @id @default(autoincrement())
  senderId      Int
  receiverId    Int
  sender        User          @relation(fields: [senderId], references: [id], name: "SenderMessages")
  receiver      User          @relation(fields: [receiverId], references: [id], name: "ReceiverMessages")
  content       String
  createdAt     DateTime      @default(now())
  messageType   MessageType   @default(TEXT)
  messageStatus MessageStatus @default(PENDING)
  deleted       Boolean       @default(false)
  attachments   String[]      @default([])
}
